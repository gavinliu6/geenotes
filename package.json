{
  "name": "geenotes",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "eslint --fix && prettier --write .",
    "check": "eslint && prettier --check .",
    "deploy": "npm run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply geenotes --local",
    "db:migrate:remote": "wrangler d1 migrations apply geenotes --remote",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/noto-serif": "^5.3.0",
    "@radix-ui/react-toast": "^1.2.23",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-aria": "^3.52.1",
    "react-aria-components": "^1.21.1",
    "react-dom": "^19.3.0",
    "react-stately": "^3.50.0",
    "shadcn": "^4.21.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tailwindcss-with": "^0.0.2",
    "tw-animate-css": "^1.4.0",
    "ulid": "^3.0.2",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.56.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.38",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^18.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "simple-git-hooks": "^2.14.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "wrangler": "^4.135.0"
  },
  "intent": {
    "skills": [
      "*"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,jsx,json,css}": "prettier --write"
  }
}
