{
  "name": "geenotes",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @geenotes/web dev",
    "build": "pnpm --filter @geenotes/web build",
    "deploy": "pnpm --filter @geenotes/web deploy",
    "lint": "eslint",
    "format": "eslint --fix && prettier --write .",
    "check": "eslint && prettier --check ."
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tanstack/eslint-config": "latest",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "intent": {
    "skills": [
      "*"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit ${1}"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{js,jsx,json,css}": "prettier --write"
  }
}
